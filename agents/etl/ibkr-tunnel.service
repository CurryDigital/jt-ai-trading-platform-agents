[Unit]
Description=IBKR Gateway SSH tunnel (autossh)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Environment="AUTOSSH_PORT=0"
Environment="AUTOSSH_POLL=30"
Environment="AUTOSSH_GATETIME=0"
ExecStart=/usr/bin/autossh -M 0 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=no -N -L 14002:127.0.0.1:4002 -i /home/ubuntu/.ssh/ibkr_ec2.pem ubuntu@52.74.14.181
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
